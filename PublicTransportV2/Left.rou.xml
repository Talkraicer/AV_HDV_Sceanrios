<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

	<vTypeDistribution id="vehicleDist">
	<vType id="AV" color="blue" probability="0.5" vClass="evehicle" />
	<vType id="HD" color="red" probability="0.5"/>
	</vTypeDistribution>
	
	<vType id="TemporalHD" color="magenta"/>
	<vType id="AllowedTemporalHD" color="orange"/>

	
    <flow id="MajorFlow" type="vehicleDist" begin="0.00" departLane="random" fromJunction="J1" toJunction="J5" end="10800" vehsPerHour="5000" departSpeed="max" />

	<vType id="Bus" guiShape="bus" vClass="bus"/>

	<flow id="bus_nonstop" type="Bus" begin="0.00" departLane="3" fromJunction="J1" toJunction="J5" end="10800" departSpeed="random" vehsPerHour="120" />

</routes>
